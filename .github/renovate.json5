{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":dependencyDashboardApproval",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      // Tool versions in workflows that no built-in manager picks up: a
      // `# renovate:` comment above a `key: value` line, and `npx pkg@x.y.z`.
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[\\w-]+:\\s*(?<currentValue>\\S+)",
        "npx (?<depName>[\\w@./-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}npm{{/if}}"
    }
  ],
  "packageRules": [
    {
      "allowedVersions": "/^(24)\\./",
      "groupName": "Node.js",
      "matchPackageNames": ["@types/node", "node"]
    },
    {
      // Packages we publish ourselves; the release-age delay guards against
      // third-party takeovers and has no purpose here.
      "matchPackageNames": ["@rotki/**"],
      "minimumReleaseAge": null
    }
  ]
}
